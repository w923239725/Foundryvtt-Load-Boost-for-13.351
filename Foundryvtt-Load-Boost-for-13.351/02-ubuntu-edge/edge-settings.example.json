{
  "kind": "manual-reference-not-an-ARM-or-provider-import-template",
  "publicHostname": "vtt.example.com",
  "origin": {
    "address": "192.0.2.10",
    "addressIsDocumentationOnly": true,
    "httpsPort": 443,
    "hostHeader": "vtt.example.com",
    "certificateNameValidation": true,
    "requireReachableOriginConfiguredByOwner": true
  },
  "healthProbe": {"protocol": "HTTPS", "method": "HEAD", "path": "/join", "expectedStatus": 200},
  "staticRoute": {
    "name": "vtt-static",
    "patterns": ["/scripts/*", "/css/*", "/fonts/*", "/icons/*"],
    "forwardingProtocol": "HTTPS",
    "cacheEnabled": true,
    "queryStringCachingBehavior": "Use Query String",
    "compressionEnabled": true,
    "respectOriginNoStoreAndPrivate": true
  },
  "defaultRoute": {
    "patterns": ["/*"],
    "forwardingProtocol": "HTTPS",
    "cacheEnabled": false,
    "webSocketSupportRequired": true
  },
  "doNotForceCache": ["/join", "/game", "/socket.io/*", "/modules/*", "/systems/*", "/worlds/*"],
  "originAccess": "Owner must configure supported origin restriction and trusted proxy identity; no allow-all real-IP configuration is supplied."
}
